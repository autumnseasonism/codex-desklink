{
  "name": "codex-desklink",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./pi-extension.mjs"
    ]
  },
  "description": "Connect Claude Code and PI to your existing Codex desktop conversations through a local MCP server",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-windows.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/autumnseasonism/codex-desklink.git"
  },
  "homepage": "https://github.com/autumnseasonism/codex-desklink#readme",
  "bugs": {
    "url": "https://github.com/autumnseasonism/codex-desklink/issues"
  }
}
